{
  "name": "youtube_downloader",
  "version": "2.0.0",
  "description": "AT Youtube Downloader: download a single YouTube video or a whole playlist as MP3 or MP4, with a modern Electron UI.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed-Atef-Tech/Youtube_Downloader.git"
  },
  "build": {
    "appId": "tech.ahmedatef.ytdownloader",
    "productName": "AT Youtube Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AT Youtube Downloader",
      "artifactName": "AT-Youtube-Downloader-Setup-${version}.exe"
    }
  },
  "keywords": [],
  "author": "Ahmed Atef",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Ahmed-Atef-Tech/Youtube_Downloader/issues"
  },
  "homepage": "https://github.com/Ahmed-Atef-Tech/Youtube_Downloader#readme",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8"
  }
}
